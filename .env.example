# .env.example

# ================================================================
# DuoGuard environment configuration
# Copy to .env and fill in your real values.
# ================================================================

MONGO_URL=mongodb://localhost:27017
DB_NAME=duo_auth
SECRET_KEY=please-change-this-to-a-long-random-string
APP_NAME=DuoGuard

# ---- Public API (used by scripts/check_api.py) ----
APP_API_KEY=dg_your_generated_key_here
DUOGUARD_BASE_URL=http://localhost:8009

# ---- Upstox daily auto-push scheduler ----
# Runs every day at 04:00 IST and pushes the current Upstox TOTP
# to the Upstox dashboard's /api/login endpoint.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_HOUR=4
SCHEDULER_MINUTE=0
SCHEDULER_RUN_ON_START=false
SCHEDULER_MISFIRE_GRACE=3600

# ---- Upstox dashboard target ----
UPSTOX_DASHBOARD_URL=http://127.0.0.1:8000
UPSTOX_ISSUER=Upstox
UPSTOX_OWNER_EMAIL=
UPSTOX_PUSH_TIMEOUT=60

# ---- Upstox app DB (used to detect token freshness) ----
# The Upstox dashboard project stores the current access token in:
#   DB:         UPSTOX_APP_V2
#   Collection: app_tokens
#   Document:   { _id: 'upstox_access_token', updated_at: '...', ... }
UPSTOX_APP_DB_NAME=UPSTOX_APP_V2
UPSTOX_APP_TOKENS_COLLECTION=app_tokens
UPSTOX_APP_TOKEN_DOC_ID=upstox_access_token

# ---- Telegram notifications ----
# Every startup check + manual/scheduled Upstox push sends a nicely
# formatted message (IST, 12-hour format) to this chat.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ---- Sensitive-data masking ----
# When true (default), all account/email identifiers are masked in:
#   dashboards, push logs, API responses, and Telegram messages.
# Set to false only for debugging on a machine you trust.
MASK_SENSITIVE_DATA=true