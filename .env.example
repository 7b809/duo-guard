# .env.example

# ================================================================
# DuoGuard environment configuration
# Copy to .env and fill in your real values.
# ================================================================

MONGO_URL=mongodb://localhost:27017
DB_NAME=duo_auth
SECRET_KEY=please-change-this-to-a-long-random-string
APP_NAME=DuoGuard

# ---- Public API (used by scripts/check_api.py) ----
APP_API_KEY=dg_your_generated_key_here
DUOGUARD_BASE_URL=http://localhost:8003

# ---- Upstox daily auto-push scheduler ----
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_HOUR=4
SCHEDULER_MINUTE=0
SCHEDULER_RUN_ON_START=false
SCHEDULER_MISFIRE_GRACE=3600

# ---- Upstox token freshness ----
UPSTOX_TOKEN_FRESH_HOUR=3
UPSTOX_TOKEN_FRESH_MINUTE=0

# ================================================================
# Platform auto-refresh list (JSON array)
# ================================================================
# IMPORTANT: values in this file are DEFAULTS. Once the app has run
# at least once, a runtime override document is stored in MongoDB
# (`runtime_config` collection, _id="global"). Any toggle you make
# via the Telegram bot is written there and takes precedence over
# what's in .env. To reset to the .env defaults, delete that
# document from Mongo.
#
# Fields per entry:
#   name         : short identifier (lowercase)
#   auto_refresh : true  -> daily scheduler job runs for this platform
#   on_boot      : true  -> ALWAYS refresh on app startup, regardless
#                           of the token's current state or time of day
#
# The two flags are INDEPENDENT:
#   auto_refresh=true,  on_boot=true   -> scheduled + always-on-boot
#   auto_refresh=true,  on_boot=false  -> scheduled only
#   auto_refresh=false, on_boot=true   -> on-boot only (tester mode)
#   auto_refresh=false, on_boot=false  -> disabled entirely
#
PLATFORMS=[{"name":"upstox","auto_refresh":true,"on_boot":true}]

# ---- Legacy fallback (used ONLY when PLATFORMS is empty) ----
UPSTOX_AUTO_REFRESH=true
UPSTOX_ON_BOOT=true

# ---- Upstox direct API mode (RECOMMENDED) ----
UPSTOX_DIRECT_LOGIN=true
UPSTOX_API_KEY=YOUR_UPSTOX_API_KEY
UPSTOX_PIN=YOUR_UPSTOX_PIN

# Optional overrides (defaults shown).
UPSTOX_TOTP_URL=https://api.upstox.com/v2/totp-login/authorization/token
UPSTOX_PROFILE_URL=https://api.upstox.com/v2/user/profile

UPSTOX_TOKEN_SOURCE=dashboard
UPSTOX_PUSH_TIMEOUT=60

# ---- Upstox dashboard (LEGACY fallback only) ----
UPSTOX_DASHBOARD_URL=http://127.0.0.1:8000
UPSTOX_ISSUER=Upstox
UPSTOX_OWNER_EMAIL=

# ---- Upstox app DB (token freshness check + token writes) ----
UPSTOX_APP_DB_NAME=UPSTOX_APP_V2
UPSTOX_APP_TOKENS_COLLECTION=app_tokens
UPSTOX_APP_TOKEN_DOC_ID=upstox_access_token

# ---- Telegram notifications ----
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ---- Telegram bot (interactive menu) ----
# Long-polling bot that runs inside the DuoGuard process. Only the
# chat configured in TELEGRAM_CHAT_ID can interact with it.
# Set to false to disable polling (notifications still work).
BOT_POLLING_ENABLED=true
# getUpdates long-poll timeout in seconds (25 is a good default)
BOT_POLL_TIMEOUT_SECONDS=25

# ---- Sensitive-data masking ----
MASK_SENSITIVE_DATA=true

# ---- Security monitoring (login + API key abuse) ----
SECURITY_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=900
LOGIN_ALERT_THRESHOLD=3
API_MAX_FAILURES=10
API_WINDOW_SECONDS=300
API_BLOCK_SECONDS=900
API_ALERT_THRESHOLD=5